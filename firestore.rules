rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Ringkasan per sel — ditulis hanya oleh Cloud Functions (Admin SDK bypass rules)
    match /cells/{cellId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Laporan mentah — dibuat mobile (anonim), dibaca dashboard & mobile
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Profil pemantau
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'pemantau';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Jejak aksi admin — hanya admin yang boleh membaca, hanya server yang menulis
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}